#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

// Custom layers
#define DEFAULT 0
#define QWERTY 1
#define WINDOWS 2

#define FN 3
#define MEDIA 4
#define NUM 5

// Default Kinesis Advantage 360 Pro layers.
#define KIN_DEF 6
#define KIN_KP 7
#define KIN_FN 8
#define KIN_MOD 9

#define ___ &trans
#define _x_ &none

#include "combos.dtsi"


/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO
      macro_ver: macro_ver {
        compatible = "zmk,behavior-macro";
        label = "macro_version";
        #binding-cells = <0>;
        bindings = <&kp RET>;
      };
      #endif

      #include "behaviors.dtsi"
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <REORDER_LEFT_RIGHT_THUMBS(
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
             &kp GRAVE     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp PSCRN   ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &kp TAB       &kp Q         &kp W         &kp E         &hlf FN R     &hlm MEDIA T  &kp DEL     ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &l NUM ESC    &hml LSHFT A  &hml LCTRL S  &hml LALT D   &hml LGUI F   &hml GLOBE G  &kp BSPC    ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
             &kp LSHFT     &kp Z         &kp X         &kp C         &kp V         &kp B       ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
             &kp GLOBE     &kp BSLH      &kp EQUAL     &kp LBKT      &kp RBKT    ,
        // ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬──────────────┬─────────────────┬───────────╮
             &mo KIN_MOD   &kp N6        &kp N7        &kp N8        &kp N9         &kp N0            &kp EQUAL ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼──────────────┼─────────────────┼───────────┤
             &kp PG_UP     &hlm MEDIA Y  &hlf FN U     &kp I         &kp O          &kp P             &kp MINUS ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼──────────────┼─────────────────┼───────────┤
             &kp PG_DN     &hmr GLOBE H  &hmr RGUI J   &hmr RALT K   &hmr RCTRL L   &hmr RSHFT SEMI   &kp SQT   ,
        // ╰─────────────┼─────────────┼─────────────┼─────────────┼──────────────┼─────────────────┼───────────┤
                           &kp N         &kp M         &kp COMMA     &kp DOT        &kp FSLH          &kp RSHFT ,
        //               ╰─────────────┼─────────────┼─────────────┼──────────────┼─────────────────┼───────────┤
                                         &kp LEFT      &kp DOWN      &kp UP         &kp RIGHT         &kp K_APP ,
        //                             ╰─────────────┴─────────────┴──────────────┴─────────────────┴───────────╯
        //
        //               ╭─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                           &kp LGUI      &kp LCTRL         &kp RCTRL     &kp RGUI    ,
        // ╭─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────╮
                                         &kp LALT          &kp RALT                                ,
        // │             │             ├─────────────┤   ├─────────────┤             │             │
             &kp SPACE     &l FN ENTER   &kp LALT          &kp RALT      &hlf FN BSPC  &m RSHFT DEL,
        // ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
      )>;
    };

    qwerty_layer {
      bindings = <REORDER_LEFT_RIGHT_THUMBS(
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
             &kp GRAVE     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp PSCRN   ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &kp TAB       &kp Q         &kp W         &kp E         &kp R         &kp T         &kp DEL     ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &kp ESC       &kp A         &kp S         &kp D         &kp F         &kp G         &kp BSPC    ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
             &kp LSHFT     &kp Z         &kp X         &kp C         &kp V         &kp B       ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
             &kp GLOBE     &kp BSLH      &kp EQUAL     &kp LBKT      &kp RBKT    ,
        // ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬──────────────┬─────────────────┬───────────╮
             &mo KIN_MOD   &kp N6        &kp N7        &kp N8        &kp N9         &kp N0            &kp EQUAL ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼──────────────┼─────────────────┼───────────┤
             &kp PG_UP     &kp Y         &kp U         &kp I         &kp O          &kp P             &kp MINUS ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼──────────────┼─────────────────┼───────────┤
             &kp PG_DN     &kp H         &kp J         &kp K         &kp L          &kp SEMI          &kp SQT   ,
        // ╰─────────────┼─────────────┼─────────────┼─────────────┼──────────────┼─────────────────┼───────────┤
                           &kp N         &kp M         &kp COMMA     &kp DOT        &kp FSLH          &kp RSHFT ,
        //               ╰─────────────┼─────────────┼─────────────┼──────────────┼─────────────────┼───────────┤
                                         &kp LEFT      &kp DOWN      &kp UP         &kp RIGHT         &kp K_APP ,
        //                             ╰─────────────┴─────────────┴──────────────┴─────────────────┴───────────╯
        //
        //               ╭─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                           &kp LGUI      &kp LCTRL         &kp RCTRL     &kp RGUI    ,
        // ╭─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────╮
                                         &kp LALT          &kp RALT                                ,
        // │             │             ├─────────────┤   ├─────────────┤             │             │
             &kp SPACE     &kp ENTER     &mo FN            &mo FN        &kp BSPC      &kp RSHFT   ,
        // ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
      )>;
    };

    windows_layer {
      bindings = <REORDER_LEFT_RIGHT_THUMBS(
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
             ___           ___           ___           ___           ___           ___           ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             ___           ___           ___           ___           ___           ___           ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             ___           ___           ___           ___           ___           ___           ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
             ___           ___           ___           ___           ___           ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
             ___           ___           ___           ___           ___         ,
        // ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
             ___           ___           ___           ___           ___           ___           ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             ___           ___           ___           ___           ___           ___           ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             ___           ___           ___           ___           ___           ___           ___         ,
        // ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           ___           ___           ___           ___           ___           ___         ,
        //               ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                                         ___           ___           ___           ___           ___         ,
        //                             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //
        //               ╭─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                           &kp LCTRL     &kp LGUI          &kp RGUI      &kp RCTRL   ,
        // ╭─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────╮
                                         ___               ___                                     ,
        // │             │             ├─────────────┤   ├─────────────┤             │             │
             ___           ___           ___               ___           ___           ___         ,
        // ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
      )>;
    };

    fn_layer {
      bindings = <REORDER_LEFT_RIGHT_THUMBS(
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
             ___           &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             ___           ___           ___           ___           ___           ___           ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &kp CAPS      &kp LSHFT     &kp LCTRL     &kp LALT      &kp LGUI      &kp GLOBE     ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
             ___           ___           ___           ___           ___           ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
             ___           ___           ___           ___           ___         ,
        // ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
             ___           &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             ___           ___           ___           ___           &kp INS       ___           &kp F11     ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             ___           &kp GLOBE     &kp RGUI      &kp RALT      &kp RCTRL     &kp RSHFT     &kp F12     ,
        // ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           ___           &kp PSCRN     &kp SCLK    &kp PAUSE_BREAK ___           ___         ,
        //               ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                                         &kp HOME      &kp PG_DN     &kp PG_UP     &kp END       &kp K_APP   ,
        //                             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //
        //               ╭─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                           ___           ___               ___           ___         ,
        // ╭─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────╮
                                         ___               ___                                     ,
        // │             │             ├─────────────┤   ├─────────────┤             │             │
             ___           ___           ___               ___           &kp DEL       ___         ,
        // ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
      )>;
    };

    media_layer {
      bindings = <REORDER_LEFT_RIGHT_THUMBS(
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
             ___           &kp C_BRI_DN  &kp C_BRI_UP  ___           ___           ___           ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             ___           ___           ___           ___           ___           ___           ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             ___           ___           ___           ___           ___           ___           ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
             ___           ___           ___           ___           ___           ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
             ___           ___           ___           ___           ___         ,
        // ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
             ___           ___           &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp C_MUTE    &kp C_EJECT ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             ___           ___           ___           ___           ___           ___           &kp C_VOL_DN,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             ___           ___           ___           ___           ___           ___           &kp C_VOL_UP,
        // ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           ___           ___           ___           ___           ___           ___         ,
        //               ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                                         ___           ___           ___           ___           ___         ,
        //                             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //
        //               ╭─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                           ___           ___               ___           ___         ,
        // ╭─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────╮
                                         ___               ___                                     ,
        // │             │             ├─────────────┤   ├─────────────┤             │             │
             ___           ___           ___               ___           ___           ___         ,
        // ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
      )>;
    };

    number_layer {
      bindings = <REORDER_LEFT_RIGHT_THUMBS(
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
             &kp EQUAL     &kp N0        &kp N9        &kp N8        &kp N7        &kp N6        ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &kp MINUS     &kp P         &kp O         &kp I         &kp U         &kp Y         ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &kp SQT       &kp SEMI      &kp L         &kp K         &kp J         &kp H         ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
             ___           &kp FSLH      &kp DOT       &kp COMMA     &kp M         &kp N       ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
             ___           &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT   ,
        // ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
             ___           ___           &kp KP_NUM    &kp KP_DIVIDE &kp KP_MULTIPLY ___         ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             ___           ___           &kp KP_N7     &kp KP_N8     &kp KP_N9     &kp KP_MINUS  ___         ,
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             ___           ___           &kp KP_N4     &kp KP_N5     &kp KP_N6     &kp KP_PLUS   ___         ,
        // ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                           ___           &kp KP_N1     &kp KP_N2     &kp KP_N3     &kp KP_ENTER  ___         ,
        //               ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
                                         ___           ___           &kp KP_DOT    ___           ___         ,
        //                             ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        //
        //               ╭─────────────┬─────────────╮   ╭─────────────┬─────────────╮
                           ___           ___               ___           ___         ,
        // ╭─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────╮
                                         ___               ___                                     ,
        // │             │             ├─────────────┤   ├─────────────┤             │             │
             ___           ___           ___               ___           ___           &kp KP_N0   ,
        // ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
      )>;
    };

    // Default Kinesis Advantage 360 Pro layers.
    kinesis_default_layer {
      bindings = <
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮                                                                                             ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
             &kp EQUAL     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &tog KIN_KP                                                                                                 &mo KIN_MOD   &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp MINUS
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤                                                                                             ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &kp TAB       &kp Q         &kp W         &kp E         &kp R         &kp T         _x_                                                                                                         _x_           &kp Y         &kp U         &kp I         &kp O         &kp P         &kp BSLH
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤                ╭─────────────┬─────────────╮   ╭─────────────┬─────────────╮                ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &kp ESC       &kp A         &kp S         &kp D         &kp F         &kp G         _x_                            &kp LCTRL     &kp LALT          &kp LGUI      &kp RCTRL                      _x_           &kp H         &kp J         &kp K         &kp L         &kp SEMI      &kp SQT
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯  ╭─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────╮  ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &kp LSHFT     &kp Z         &kp X         &kp C         &kp V         &kp B                                                      &kp HOME          &kp PG_UP                                                  &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH      &kp RSHFT
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯                │             │             ├─────────────┤   ├─────────────┤             │             │                ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &mo KIN_FN    &kp GRAVE     &kp CAPS      &kp LEFT      &kp RIGHT                                    &kp BSPC      &kp DEL       &kp END           &kp PG_DN     &kp ENTER     &kp SPACE                                    &kp UP        &kp DOWN      &kp LBKT      &kp RBKT      &mo KIN_FN
        // ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯                              ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯                              ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
      >;
    };
    kinesis_keypad {
      bindings = <
        // ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮                                                                                             ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
             &kp EQUAL     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        ___                                                                                                         &mo KIN_MOD   &kp N6        &kp KP_NUM    &kp KP_EQUAL  &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤                                                                                             ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &kp TAB       &kp Q         &kp W         &kp E         &kp R         &kp T         _x_                                                                                                         _x_           &kp Y         &kp KP_N7     &kp KP_N8     &kp KP_N9     &kp KP_MINUS  &kp BSLH
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤                ╭─────────────┬─────────────╮   ╭─────────────┬─────────────╮                ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &kp ESC       &kp A         &kp S         &kp D         &kp F         &kp G         _x_                            &kp LCTRL     &kp LALT          &kp LGUI      &kp RCTRL                      _x_           &kp H         &kp KP_N4     &kp KP_N5     &kp KP_N6     &kp KP_PLUS   &kp SQT
        // ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯  ╭─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────╮  ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
             &kp LSHFT     &kp Z         &kp X         &kp C         &kp V         &kp B                                                      &kp HOME          &kp PG_UP                                                  &kp N         &kp KP_N1     &kp KP_N2     &kp KP_N3     &kp KP_ENTER  &kp RSHFT
